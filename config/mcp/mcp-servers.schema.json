{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Servers canonical config",
  "type": "object",
  "properties": {
    "version": { "type": "integer" },
    "$comment": { "type": "string" },
    "client_sets": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } },
      "description": "Nhóm client đặt tên. Mỗi server trỏ tới 1 nhóm qua 'set'."
    },
    "default_set": { "type": "string", "description": "Nhóm mặc định khi server không khai 'set'." },
    "servers": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["servers"]
}
